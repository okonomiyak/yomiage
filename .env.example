# Discord Bot トークン（Developer Portal で発行）
# Message Content Intent を有効化しておくこと（無効だと本文が空で届く）
DISCORD_TOKEN=

# VOICEVOX ENGINE のベース URL
# compose 内から: http://voicevox:50021
# ホストから直接叩く場合: http://localhost:50021
VOICEVOX_URL=http://voicevox:50021

# SQLite の場所（コンテナ内パス）
DATABASE_URL=sqlite:/data/bot.db

# ログレベル
RUST_LOG=info,yomiage_bot=debug
